<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Japón · Junio 2018</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --ink: #1a1a1a; --muted: #6b6b6b;
    --accent: #b5001a; --accent-light: #fbe8ea;
    --warm: #c9a96e; --bg-a: #eef2f7; --bg-b: #f7f4ef; --radius: 12px;
  }
  body { font-family: 'Inter', sans-serif; font-weight: 300; color: var(--ink); line-height: 1.7; font-size: 16px; background: var(--bg-a); }

  /* HERO */
  .hero { min-height: 70vh; background: #0a0004; position: relative; overflow: hidden; }
  .hero-photos { position: absolute; inset: 0; }
  .hero-photos img { width:100%; height:100%; object-fit:cover; opacity:0.72; }
  .hero-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 60%); }
  .hero-top { position: absolute; top: 40px; left: 48px; text-align: left; }
  .hero-top h1 { font-family: 'Instrument Serif', serif; font-size: clamp(32px,5vw,60px); font-weight: 400; color: #fff; line-height: 1.1; }
  .hero-top h1 em { font-style: italic; color: var(--warm); }
  .hero-top .tag { font-size: 12px; font-weight: 500; letter-spacing: 0.12em; color: var(--warm); text-transform: uppercase; margin-top: 8px; }
  .hero-bottom { position: absolute; bottom: 40px; left: 48px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 20px; color: rgba(255,255,255,0.6); font-size: 13px; }

  /* NAV */
  nav { position: sticky; top: 0; background: #fff; border-bottom: 1px solid #e8d8d8; padding: 0 48px; display: flex; z-index: 100; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav a { display: block; padding: 14px 16px; font-size: 13px; font-weight: 500; color: var(--muted); text-decoration: none; border-bottom: 2px solid transparent; white-space: nowrap; transition: color 0.2s, border-color 0.2s; }
  nav a:hover { color: var(--ink); border-color: var(--accent); }

  /* SECTIONS */
  section { padding: 48px 32px; }
  section:nth-of-type(odd) { background: var(--bg-a); }
  section:nth-of-type(even) { background: var(--bg-b); }
  .inner { max-width: 900px; margin: 0 auto; }
  .section-label { font-size: 11px; font-weight: 500; letter-spacing: 0.1em; color: var(--warm); text-transform: uppercase; margin-bottom: 10px; }
  h2 { font-family: 'Instrument Serif', serif; font-size: clamp(26px,4vw,38px); font-weight: 400; line-height: 1.2; margin-bottom: 16px; }
  p { color: #3d3d3d; margin-bottom: 14px; max-width: 640px; }

  /* STATS */
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(110px,1fr)); gap: 1px; background: #c8a0a0; border-radius: var(--radius); overflow: hidden; margin: 20px 0; }
  .stat { background: #fff; padding: 20px; text-align: center; }
  .stat-value { font-family: 'Instrument Serif', serif; font-size: 32px; color: var(--accent); line-height: 1; margin-bottom: 2px; }
  .stat-label { font-size: 11px; color: var(--muted); }

  /* CITY BLOCK */
  .city-block { margin: 28px 0; }
  .city-header { display: flex; align-items: baseline; gap: 12px; margin-bottom: 6px; padding-bottom: 10px; border-bottom: 1px solid rgba(0,0,0,0.08); }
  .city-name { font-family: 'Instrument Serif', serif; font-size: 22px; font-weight: 400; }
  .city-sub { font-size: 13px; color: var(--muted); font-style: italic; }
  .city-count { font-size: 12px; color: var(--muted); margin-left: auto; }
  .city-notes { margin: 6px 0 10px; }
  .city-notes p { font-size: 13px; color: var(--muted); margin: 0; }
  .city-notes span { display: inline-block; margin-right: 14px; }
  .city-notes span::before { content: '· '; }

  /* CARRUSEL MUY PEQUEÑO (Tokio) */
  .carousel-xs .carousel-track .thumb { width: 120px; height: 120px; border-radius: 6px; }
  .carousel-xs .carousel-track .thumb:first-child { width: 160px; }

  /* CARRUSEL NORMAL */
  .carousel { position: relative; margin: 8px 0; }
  .carousel-track { display: flex; gap: 5px; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth; padding-bottom: 6px; cursor: grab; scrollbar-width: none; }
  .carousel-track:active { cursor: grabbing; }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-track .thumb { flex: 0 0 auto; scroll-snap-align: start; width: 170px; height: 200px; border-radius: 8px; }
  .carousel-track .thumb:first-child { width: 220px; }
  .carousel-track .thumb img { width:100%; height:100%; object-fit:cover; display:block; border-radius: 8px; }
  .carousel-controls { display: flex; align-items: center; gap: 8px; margin-top: 6px; }
  .carousel-btn { width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid #d0b0b0; background: #fff; color: var(--ink); font-size: 14px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: border-color 0.2s; }
  .carousel-btn:hover { border-color: var(--accent); }
  .carousel-hint { font-size: 11px; color: var(--muted); margin-left: 4px; }

  /* THUMB */
  .thumb { position: relative; cursor: zoom-in; overflow: hidden; background: #d0c0c0; display: block; }
  .thumb img { transition: transform 0.3s; }
  .thumb:hover img { transform: scale(1.05); }
  .thumb .cap { position:absolute; bottom:0; left:0; right:0; padding:18px 8px 6px; background:linear-gradient(transparent,rgba(0,0,0,0.45)); color:#fff; font-size:10px; opacity:0; transition:opacity 0.2s; }
  .thumb:hover .cap { opacity:1; }

  /* VÍDEO EN CARRUSEL */
  .carousel-track .vid-item { flex: 0 0 auto; scroll-snap-align: start; width: 240px; height: 200px; border-radius: 8px; overflow: hidden; background: #000; }
  .carousel-track .vid-item video { width:100%; height:100%; object-fit:cover; display:block; }
  .carousel-xs .carousel-track .vid-item { width: 160px; height: 120px; }

  /* VÍDEOS DIFERENCIADOS */
  .video-pill {
    display: flex; gap: 8px; align-items: flex-start;
    background: var(--ink); color: #fff;
    border-radius: var(--radius); padding: 14px 16px; margin: 12px 0;
  }
  .video-pill .vp-icon { font-size: 20px; flex-shrink: 0; margin-top: 2px; }
  .video-pill .vp-info { flex: 1; min-width: 0; }
  .video-pill .vp-title { font-size: 13px; font-weight: 500; color: var(--warm); margin-bottom: 6px; }
  .video-pill .vp-video { border-radius: 8px; overflow: hidden; background: #000; }
  .video-pill .vp-video video { width: 100%; max-height: 220px; display: block; }

  /* SECCIÓN NEONES */
  .neon-section { background: #050010; padding: 48px 32px; }
  .neon-section .section-label { color: #ff6ec7; }
  .neon-section h2 { color: #fff; }
  .neon-section p { color: rgba(255,255,255,0.55); }
  .neon-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin: 16px 0;
  }
  .neon-grid .ng {
    aspect-ratio: 3/4;
    border-radius: 8px; overflow: hidden; cursor: zoom-in;
    background: #100020; position: relative;
  }
  .neon-grid .ng img { width:100%; height:100%; object-fit:cover; display:block; transition: transform 0.4s, filter 0.4s; filter: saturate(1.2) brightness(0.9); }
  .neon-grid .ng:hover img { transform: scale(1.06); filter: saturate(1.6) brightness(1.1); }

  /* SECCIÓN COMIDA */
  .food-strip { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 16px 0; }
  .food-strip::-webkit-scrollbar { display: none; }
  .food-strip .fs { flex: 0 0 auto; width: 150px; height: 150px; border-radius: 8px; overflow: hidden; cursor: zoom-in; background: #e0d0c0; position: relative; }
  .food-strip .fs img { width:100%; height:100%; object-fit:cover; display:block; transition: transform 0.3s; }
  .food-strip .fs:hover img { transform: scale(1.06); }

  /* MOMENTOS */
  .moments { display:flex; flex-direction:column; margin:20px 0; }
  .moment { display:grid; grid-template-columns:48px 1fr; gap:14px; padding:14px 0; border-bottom:1px solid #e8d0d0; align-items:start; }
  .moment:last-child { border-bottom:none; }
  .moment-emoji { width:44px; height:44px; background:var(--accent-light); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
  .moment-title { font-weight:500; font-size:14px; margin-bottom:2px; }
  .moment-desc { font-size:13px; color:var(--muted); margin:0; }

  /* VALORACIÓN */
  .ratings { display:flex; flex-direction:column; gap:12px; margin:20px 0; }
  .rating-row { display:flex; align-items:center; gap:14px; }
  .rating-label { font-size:13px; min-width:160px; color:var(--muted); }
  .rating-bar { flex:1; height:5px; background:#e8d0d0; border-radius:3px; overflow:hidden; }
  .rating-fill { height:100%; background:var(--accent); border-radius:3px; }
  .rating-score { font-family:'Instrument Serif',serif; font-size:17px; min-width:32px; text-align:right; }

  .verdict { display:grid; grid-template-columns:1fr 1fr; gap:16px; margin:20px 0; }
  .verdict-box { padding:20px; border-radius:var(--radius); }
  .verdict-box.good { background:#edf6ed; }
  .verdict-box.bad { background:#fce8e8; }
  .verdict-title { font-weight:500; font-size:12px; margin-bottom:10px; }
  .verdict-box.good .verdict-title { color:#2d6a4f; }
  .verdict-box.bad .verdict-title { color:#b03030; }
  .verdict-list { list-style:none; display:flex; flex-direction:column; gap:6px; }
  .verdict-list li { font-size:13px; color:#3d3d3d; padding-left:14px; position:relative; margin:0; }
  .verdict-list li::before { content:'·'; position:absolute; left:4px; color:var(--muted); }

  .quote-block { border-left:3px solid var(--warm); padding:16px 24px; margin:20px 0; background:rgba(201,169,110,0.08); border-radius:0 var(--radius) var(--radius) 0; }
  .quote-block p { font-family:'Instrument Serif',serif; font-size:19px; font-style:italic; line-height:1.5; max-width:none; margin:0; }

  /* LIGHTBOX */
  .lightbox { display:none; position:fixed; inset:0; z-index:999; background:rgba(4,0,8,0.97); align-items:center; justify-content:center; flex-direction:column; }
  .lightbox.open { display:flex; }
  .lightbox img { max-width:90vw; max-height:82vh; object-fit:contain; border-radius:6px; }
  .lb-caption { color:rgba(255,255,255,0.6); font-size:13px; margin-top:14px; }
  .lb-nav { position:absolute; top:50%; transform:translateY(-50%); background:rgba(255,255,255,0.12); border:none; color:#fff; width:48px; height:48px; border-radius:50%; font-size:22px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .lb-prev { left:20px; } .lb-next { right:20px; }
  .lb-close { position:absolute; top:20px; right:24px; background:none; border:none; color:rgba(255,255,255,0.6); font-size:28px; cursor:pointer; }
  .lb-dots { display:flex; gap:5px; margin-top:12px; flex-wrap:wrap; justify-content:center; max-width:400px; }
  .lb-dot { width:6px; height:6px; border-radius:50%; background:rgba(255,255,255,0.3); border:none; cursor:pointer; }
  .lb-dot.on { background:rgba(255,255,255,0.9); }

  footer { text-align:center; padding:40px 32px; font-size:12px; color:var(--muted); background:var(--bg-a); border-top:1px solid #d8c0c0; }

  @media (max-width:640px) {
    .hero-top { top:24px; left:24px; }
    .hero-bottom { bottom:24px; left:24px; }
    nav { padding:0 16px; }
    section, .neon-section { padding:36px 20px; }
    .neon-grid { grid-template-columns: repeat(2,1fr); }
    .verdict { grid-template-columns:1fr; }
    .lb-nav { display:none; }
  }
</style>
</head>
<body>

<div class="hero">
  <div class="hero-photos">
    <img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548929/IMG_3848.jpg" alt="Japón">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-top">
    <h1>Japón<br><em>Pagodas, Ramen y Toris</em></h1>
    <div class="tag">Junio 2018 · Railway Pass</div>
  </div>
  <div class="hero-bottom">
    <div class="hero-meta">
      <span>🇯🇵 Tokio · Hakone · Kyoto · Nara · Hiroshima · Miyajima</span>
      <span>⚽ Viendo el Mundial en el avión</span>
      <span>🍜 Ramen, sake y máquinas expendedoras</span>
    </div>
  </div>
</div>

<nav>
  <a href="#resumen">Resumen</a>
  <a href="#tokio">Tokio</a>
  <a href="#hakone">Hakone</a>
  <a href="#kyoto">Kyoto</a>
  <a href="#nara">Nara</a>
  <a href="#hiroshima">Hiroshima</a>
  <a href="#miyajima">Miyajima</a>
  <a href="#comida">Comida</a>
  <a href="#momentos">Momentos</a>
</nav>

<!-- RESUMEN -->
<section id="resumen">
  <div class="inner">
    <div class="section-label">El viaje</div>
    <h2>De pensar en Grecia a acabar en Japón · culpa del pater</h2>
    <p>El plan era Grecia. El padre lo cambió todo. ¿Quién va a ir a Japón? Pues nosotros, en junio de 2018, viendo los partidos del Mundial en directo desde el avión camino a Tokio.</p>
    <p>Railway Pass en mano y a recorrer el país de norte a sur: Tokio y sus contrastes, Hakone y el Monte Fuji, Kyoto y sus templos, los ciervos de Nara, el Memorial de Hiroshima y la isla de Miyajima. Probando todas las bebidas raras de las máquinas expendedoras del camino.</p>

    <div class="stats">
      <div class="stat"><div class="stat-value">6</div><div class="stat-label">ciudades</div></div>
      <div class="stat"><div class="stat-value">1</div><div class="stat-label">Railway Pass</div></div>
      <div class="stat"><div class="stat-value">0</div><div class="stat-label">carteras robadas (Japón)</div></div>
      <div class="stat"><div class="stat-value">∞</div><div class="stat-label">ramen consumido</div></div>
    </div>
  </div>
</section>

<!-- FOTOS POR CIUDAD -->
<section id="fotos">
  <div class="inner">
    <div class="section-label">Ciudad a ciudad</div>
    <h2>El viaje en imágenes</h2>
    <p style="font-size:13px; color:var(--muted); margin-bottom:16px;">Haz clic en cualquier foto para verla en grande.</p>

    <!-- TOKIO -->
    <div class="city-block" id="tokio">
      <div class="city-header">
        <span class="city-name">Tokio</span>
        <span class="city-sub">Shibuya · Akihabara · Kabukicho · Kamakura</span>
      </div>
      <div class="city-notes"><p>
        <span>Shibuya crossing</span>
        <span>Manga y videojuegos en Akihabara</span>
        <span>Hotel cápsula en Ginza</span>
        <span>Neones de Kabukicho</span>
        <span>Buda gigante de Kamakura</span>
      </p></div>

      <div class="video-pill">
        <div class="vp-icon">🎵</div>
        <div class="vp-info">
          <div class="vp-title">Tocando la ocarina en el metro de Tokio</div>
          <div class="vp-video"><video controls preload="none"><source src="https://res.cloudinary.com/il7cecht/video/upload/v1791548936/VIDEO-2018-07-06-14-39-05.mp4" type="video/mp4"></video></div>
        </div>
      </div>

      <div class="carousel carousel-xs">
        <div class="carousel-track" id="c-tokio">
          <div class="thumb" onclick="lb(0)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548909/3f8736a1-957f-44a8-9db2-cead9f4ca020.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(1)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548918/IMG_2579.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(2)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548918/IMG_2611.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(3)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548918/IMG_2598.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(4)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548917/IMG_2572.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(5)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548917/IMG_2568.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(6)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548918/IMG_2680.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(7)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548920/IMG_2763.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(8)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548919/IMG_2760.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(9)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548919/IMG_2719.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(10)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548919/IMG_2703.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(11)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548922/IMG_2888.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(12)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548922/IMG_2878.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(13)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548922/IMG_2867.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(14)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548921/IMG_2853.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(15)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548923/IMG_2985.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(16)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548923/IMG_2916.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(17)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548909/6651ac21-54de-483e-8b0f-ddb6e528927e.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(18)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548910/21773b32-706b-4873-a5e0-2060fdf55da8.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(19)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548912/ad48eb75-615c-4c12-b398-fc9df25f02f1.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(20)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548915/f6a14ac2-5ee1-4a30-980f-f9f1a081bc38.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(21)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548916/f52be781-85ef-4a96-b9e4-4a2edd6c4270.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(22)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548915/eff256a4-8778-434a-8987-337cb80d8e96.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(23)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548924/IMG_3009.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(24)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548930/IMG_3946.jpg" alt="Tokio"><div class="cap">Kamakura</div></div>
          <div class="thumb" onclick="lb(25)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548930/IMG_3949.jpg" alt="Tokio"><div class="cap">Kamakura</div></div>
          <div class="thumb" onclick="lb(26)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548914/db33ac16-ef8c-4085-a699-e31474c591dc.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(27)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548933/IMG_4190.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
          <div class="thumb" onclick="lb(28)"><img src="https://res.cloudinary.com/il7cecht/image/upload/v1791548932/IMG_4145.jpg" alt="Tokio"><div class="cap">Tokio</div></div>
