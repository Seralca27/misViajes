let cur=0;
const lbox=document.getElementById('lightbox');
const lbImg=document.getElementById('lb-img');
const lbCap=document.getElementById('lb-cap');
const lbDots=document.getElementById('lb-dots');

photos.forEach((_,i)=>{
  const d=document.createElement('button');
  d.className='lb-dot'+(i===0?' on':'');
  d.onclick=e=>{e.stopPropagation();lb(i);};
  lbDots.appendChild(d);
});

function lb(i){
  cur=i;lbImg.src=photos[i].s;lbCap.textContent=photos[i].c;
  document.querySelectorAll('.lb-dot').forEach((d,j)=>d.classList.toggle('on',j===i));
  lbox.classList.add('open');document.body.style.overflow='hidden';
}
function closeLb(){lbox.classList.remove('open');document.body.style.overflow='';}
function closeLbOutside(e){if(e.target===lbox)closeLb();}
function shiftLb(d){lb((cur+d+photos.length)%photos.length);}
function scrollC(id,dir){document.getElementById(id).scrollBy({left:dir*200,behavior:'smooth'});}

document.querySelectorAll('.carousel-track').forEach(track=>{
  let down=false,sx,sl;
  track.addEventListener('mousedown',e=>{down=true;sx=e.pageX-track.offsetLeft;sl=track.scrollLeft;});
  track.addEventListener('mouseleave',()=>down=false);
  track.addEventListener('mouseup',()=>down=false);
  track.addEventListener('mousemove',e=>{if(!down)return;e.preventDefault();track.scrollLeft=sl-(e.pageX-track.offsetLeft-sx);});
});

document.addEventListener('keydown',e=>{
  if(!lbox.classList.contains('open'))return;
  if(e.key==='ArrowRight')shiftLb(1);
  if(e.key==='ArrowLeft')shiftLb(-1);
  if(e.key==='Escape')closeLb();
});
let touchStartX=0;
document.getElementById('lightbox').addEventListener('touchstart',e=>{touchStartX=e.touches[0].clientX;},{passive:true});
document.getElementById('lightbox').addEventListener('touchend',e=>{
  const diff=touchStartX-e.changedTouches[0].clientX;
  if(Math.abs(diff)>50)diff>0?shiftLb(1):shiftLb(-1);
});
</script>
</body>
</html>
